# Copy to .env and fill in. Never commit .env (it is gitignored).
# In CI these come from GitHub Actions secrets / variables.

# Target environment
BASE_URL=https://staging.firmable.com

# Existing test account (emailed by Firmable). REQUIRED for app tests.
FIRMABLE_USER_EMAIL=
FIRMABLE_USER_PASSWORD=

# Prefix for everything the suite creates (your initials). Makes cleanup safe.
TEST_DATA_PREFIX=qa-as

# Clerk test mode sign up settings (documented by Firmable)
CLERK_TEST_EMAIL_DOMAIN=example.com
CLERK_TEST_OTP=424242

# Credit guard: credit tests are skipped when the balance is below this number,
# so we never drain the shared staging account.
MIN_CREDITS_FOR_SPEND_TESTS=5

# Max records a reveal / export test may touch (keeps credit spend tiny)
MAX_CREDIT_RECORDS=2

# Optional: known credit prices. When set, tests assert the EXACT deduction.
EMAIL_REVEAL_COST=
PHONE_REVEAL_COST=

# Optional: Slack incoming webhook used by CI notifications
SLACK_WEBHOOK_URL=
